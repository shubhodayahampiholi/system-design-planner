# Anthropic - required, powers the planner and all domain specialists
ANTHROPIC_API_KEY=sk-ant-your-key-here

# OpenAI - required for the reference-extractor subagent (cross-provider delegation)
OPENAI_API_KEY=sk-your-key-here

# LangSmith - optional, enables tracing. Set LANGSMITH_ENDPOINT to the EU
# endpoint (https://api.smith.langchain.com/eu) if your account is EU-region -
# check your LangSmith Settings page to confirm which applies to you.
LANGSMITH_TRACING=true
LANGSMITH_API_KEY=your-langsmith-key-here
LANGSMITH_PROJECT=system-design-planner
LANGSMITH_ENDPOINT=https://api.smith.langchain.com

# Tavily - required for the check_current_standards tool
TAVILY_API_KEY=tvly-your-key-here
